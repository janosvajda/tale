TALE v0
META
  ID tale.project
  TYPE project
  LANGUAGE TypeScript
  RUNTIME Electron
  TEST_FRAMEWORK node:test

GOAL
  Build a cross-platform Electron app for visually authoring reusable human-agent agreements.
  Edit all Tale tags on a precise SVG board, save projects as JSON, and compile deployable .tale files.

PRODUCT
  platforms macOS Windows Linux
  editor miro_style
  items rectangle arrow
  connections branches loops multiple
  project_format JSON
  tags diagram_items
  tag_coverage all_defined
  rule_types user_defined
  environments user_defined
  output .tale/*.tale
  agent_entrypoints official

ARCHITECTURE
  separate visual_editor svg_library electron_ui application preload
  svg_library first_party_reusable
  editor_dependencies svg_library project_model
  ui native_html_css_browser_apis
  application_dependencies no_ui_or_svg
  filesystem electron_main
  ipc typed_allowlisted_preload_api
  ipc_validation sender_payload_result
  context_isolation true
  node_integration false
  renderer_sandbox true
  project_content inert_data

EDITOR
  layout board_first
  viewport fit_app_window
  app_scroll deny
  canvas_navigation pan_zoom
  zoom_input touchpad mouse
  zoom_anchor pointer
  chrome compact
  copy concise
  oversized_headings deny
  item_titles required_editable
  item_text editable
  dragging pointer_accurate
  draggable all_diagram_objects
  connections anchored_precise
  tag_colors distinct_stable
  tag_labels visible
  toolbar all_diagram_items
  toolbar_labels visible
  menu open_json save save_as deploy
  property_controls semantic_typed
  raw_json_editing deny

DEPLOYMENT
  mode compiled_tales
  project_json save_save_as_only
  target selected_project
  output .tale/*.tale
  agents user_selected
  agent_file selected_official_entrypoint
  agent_update preserve_content_upsert_reference
  preview required
  existing_tale confirm_overwrite
  unrelated_files preserve
  repeat idempotent

DEPENDENCIES
  default deny
  allow electron
  development_allow typescript @biomejs/biome
  changes require_approval

AGREEMENT
  before_implementation agree_goal_scope_checks
  unclear_requirements ask_user
  scope_expansion require_approval
  existing_approval reuse
  contract_changes require_approval
  structured_conflicts block
  approval_baseline external

CHANGES
  default minimal
  refactor require_approval
  rename require_approval
  delete require_approval
  unrelated_changes deny
  preserve_user_changes true
  restore_deleted_code require_approval

SCOPE allow
  approved_task_files

SCOPE deny
  .git/**

SCOPE require_approval
  .tale/**
  AGENTS.md
  README.md
  docs/project-policy.md
  *.tale
  package.json
  *lock*
  tsconfig*.json
  biome.json*

QUALITY
  typescript_strict true
  lint biome
  format biome
  weaken_checks deny

TESTING
  assertions observable_behavior
  bugfix regression_test
  changed_behavior require_coverage
  editor_changes interaction_check
  editor_cases drag_zoom connect_move_resize edit_save_reopen tag_coverage
  ui_cases all_objects_draggable no_app_scroll touchpad_mouse_zoom toolbar_coverage file_menu
  ipc_changes boundary_tests
  editor_e2e json_to_tale_determinism
  deploy_e2e compiled_tales_agent_entrypoint
  weaken_expectations deny
  test_files paired_sibling
  test_pattern {name}.test.ts
  test_scope application_typescript
  test_pair_check npm_run_lint

DETERMINISM
  mode strict
  target compiled_tales
  comparison byte_exact
  encoding utf8
  line_endings lf
  final_newline true
  rerun_check runs=2
  clean_build_check runs=2

AGENTIC_TESTS
  pattern **/*.ai.test.ts
  allow_create true
  allow_modify within_task
  freeze_after proof_pass

PROOF
  run "npm run typecheck" expect exit=0 when=code_changed
  run "npm run lint" expect exit=0 when=code_changed
  run "npm run format:check" expect exit=0 when=code_changed
  run "npm test" expect exit=0 when=code_changed
  run "npm run test:e2e" expect exit=0 when=code_changed
  contract_verify baseline=external coverage=mandatory
  review scope unrelated_behavior added_lines
  stop after_agreed_checks

REQUIREMENT
  id deployment-bytes
  action deploy
  subject artifacts/contract-deployment/.tale/project.tale
  condition equals_file
  expected .tale/project.tale
  mandatory true
  verified_by deploy-check

REQUIREMENT
  id no-project-json
  action deploy
  subject artifacts/contract-deployment/.tale/tale.project.json
  condition absent
  expected ""
  mandatory true
  verified_by deploy-check

REQUIREMENT
  id preserve-project
  action deploy
  subject project/tale.project.json
  condition unchanged
  expected ""
  mandatory true
  verified_by deploy-check

CHECK
  id deploy-check
  action deploy
  executable node
  arguments scripts/prove-deployment.mjs
  protected_files scripts/prove-deployment.mjs
  timeout_ms 30000
