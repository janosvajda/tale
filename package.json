{
	"name": "tale",
	"productName": "Tale",
  "version": "0.1.0",
  "private": true,
  "description": "A visual editor for human-agent agreements",
  "main": "dist/node/src/main/index.js",
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "lint": "biome lint . && node scripts/test-pairs.mjs",
    "format:check": "biome format .",
    "format": "biome check --write .",
    "test": "npm run build && node scripts/test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "typescript": "7.0.2",
    "@biomejs/biome": "2.5.14"
  }
}
